<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>SoundCloudExplode</id>
    <version>1.6.3</version>
    <authors>Jerro</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>favicon.png</icon>
    <projectUrl>https://github.com/jerry08/SoundCloudExplode</projectUrl>
    <description>Library that provides an interface to query metadata of SoundCloud tracks and playlists, as well as to resolve and download audio.</description>
    <copyright>Copyright (C) Jerry Berry</copyright>
    <tags>soundcloud download playlist user channel tracks parse extract metadata info net core standard</tags>
    <repository type="git" url="https://github.com/jerry08/SoundCloudExplode" commit="53ebe6ce4b19c5b5c631844891471626105621a9" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="8.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Text.Json" version="8.0.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETCoreApp3.1">
        <dependency id="System.Text.Json" version="8.0.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0" />
      <group targetFramework=".NETStandard2.0">
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="8.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Text.Json" version="8.0.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="System.Text.Json" version="8.0.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>